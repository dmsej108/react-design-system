{
  "name": "@zzou/design-system",
  "version": "1.1.6",
  "private": false,
  "type": "module",
  "description": "Reusable React design system for zzou.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzous/react-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/zzous/react-design-system/issues"
  },
  "homepage": "https://zzous.github.io/react-design-system/",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.css": "./dist/index.css",
    "./styles": "./src/tokens/index.css",
    "./legacy-styles": "./src/styles/index.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles",
    "src/tokens"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "storybook dev --port 6006",
    "storybook": "storybook dev --port 6006",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config vite.lib.config.ts",
    "build-storybook": "storybook build",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "react-datepicker": "^9.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.17",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.17",
    "@storybook/react-vite": "^8.6.17",
    "@types/react": "^18.3.3",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "^8.6.17",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.4",
    "vite-plugin-dts": "^5.0.0"
  }
}
